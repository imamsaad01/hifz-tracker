# Public values from Supabase → Project Settings → API. Safe to use in the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Secrets for the notify Edge Function. Set them in Supabase → Edge Functions → Secrets, NEVER here in the browser app.
# BREVO_API_KEY=...
# SENDER_EMAIL=you@gmail.com
# SENDER_NAME=Hifz Tracker
# CRON_SECRET=a-long-random-string
